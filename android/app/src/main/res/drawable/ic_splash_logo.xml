<?xml version="1.0" encoding="utf-8"?>

<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ========================================================= -->
    <!-- KASIRA BLUE CONTAINER                                     -->
    <!-- ========================================================= -->

    <item
        android:width="92dp"
        android:height="92dp"
        android:gravity="center">

        <shape android:shape="rectangle">

            <solid android:color="#00529C" />

            <corners android:radius="26dp" />

        </shape>

    </item>


    <!-- ========================================================= -->
    <!-- POINT OF SALE ICON                                        -->
    <!-- ========================================================= -->

    <item
        android:width="44dp"
        android:height="44dp"
        android:gravity="center">

        <drawable android:drawable="@drawable/ic_point_of_sale" />

    </item>


    <!-- ========================================================= -->
    <!-- ACCENT DOT                                                -->
    <!-- ========================================================= -->

    <item
        android:width="11dp"
        android:height="11dp"
        android:gravity="center"
        android:left="55dp"
        android:top="14dp"
        android:right="26dp"
        android:bottom="67dp">

        <drawable android:drawable="@drawable/ic_splash_accent" />

    </item>

</layer-list>